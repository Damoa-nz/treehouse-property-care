# Copy this file to .env.local and fill in real values from your
# Supabase project (Settings -> API).

# Safe to expose to the browser:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_, never commit, never
# send to the browser. Bypasses RLS entirely. Used only by
# src/app/api/quote-requests/route.ts to accept public form submissions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
